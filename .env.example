# Copy this file to `.env` and replace the example values.
# Generate real secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Shared by both services -------------------------------------------------
# Secret the gateway sends to the backend in the X-Service-Key header.
BACKEND_SERVICE_KEY=change-me-backend-service-key

LOG_LEVEL=INFO

# --- Backend -----------------------------------------------------------------
# Artificial delay added to every backend response (used by a test to force a timeout).
SIMULATED_LATENCY_MS=0

# --- Gateway -----------------------------------------------------------------
# Where the gateway finds the backend. In docker-compose this is http://backend:8001.
BACKEND_URL=http://localhost:8001

# Secret AI clients must send as "Authorization: Bearer <token>". Separate from the service key.
MCP_CLIENT_TOKEN=change-me-mcp-client-token

# Seconds the gateway waits for the backend before giving up.
BACKEND_TIMEOUT_S=5

# Port the gateway listens on (streamable HTTP transport).
PORT=8000
